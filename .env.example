# Copia este archivo a .env.local y rellena los valores desde el panel de Supabase
# (Project Settings → API). .env.local no se versiona.
#
# URL del proyecto, p. ej. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública. Vale cualquiera de las dos, según lo que muestre tu proyecto:
#   - Publishable key (recomendada por Supabase): sb_publishable_...
#   - anon key (heredada): eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR: nunca la expongas con NEXT_PUBLIC_ ni la subas al repositorio.
# La usan las rutas de API para escribir estado y el test de dos cuentas.
SUPABASE_SERVICE_ROLE_KEY=
