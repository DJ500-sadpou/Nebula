{
  "name": "mundo-perdido",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "El Mundo Perdido — motor de reglas, simulador y aplicación Next.js (Fase 1)",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "tsx tests/rls/two-accounts.ts",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/simulate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
